# Discord application bot token (Developer Portal > Your App > Bot > Reset Token)
DISCORD_TOKEN=

# Right-click your server name in Discord > Copy Server ID
# (needs Developer Mode on: Settings > Advanced > Developer Mode)
GUILD_ID=

# Where your team plays. euw1/europe covers the UK.
RIOT_PLATFORM=euw1
RIOT_REGION=europe
OPGG_REGION=euw

# Where the bot posts rank changes and weekly roundups.
STAT_CHANNEL=stat-updates

# Where the SQLite file lives. On Railway, point this at a mounted volume.
DATABASE_PATH=./data/royal-bears.db
